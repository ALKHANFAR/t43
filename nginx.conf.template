server {
  listen 80;
  server_name _;
  root /usr/share/nginx/html;
  index index.html;
  # بوابة سيادة على نفس الأصل — GATEWAY_URL يُستبدل عند التشغيل (envsubst في صورة nginx الرسمية)
  location /siyadah-api/ {
    proxy_pass ${GATEWAY_URL}/;
    proxy_http_version 1.1;
    proxy_ssl_server_name on;
    proxy_set_header Host $proxy_host;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_read_timeout 120s;
    add_header Cache-Control "no-store" always;
  }
  location ~* \.(?:html|js|css)$ {
    add_header Cache-Control "no-cache";
    try_files $uri =404;
  }
  location ~* \.(?:png|jpg|jpeg|gif|svg|ico|webp|woff2?|ttf|eot|json|txt|xml)$ {
    add_header Cache-Control "public, max-age=86400, must-revalidate";
    try_files $uri =404;
  }
  location / {
    add_header Cache-Control "no-cache";
    try_files $uri $uri/ /404.html =404;
  }
}
